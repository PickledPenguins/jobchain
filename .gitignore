tmp/
__pycache__/

# Build products: install.sh / make rebuild these; a compiled binary tracked
# in git goes stale or wrong-arch across machines, and every local build
# dirties the working tree for no reason.
/bin/jobchain-node
*.dSYM/

# Coverage: generated by run_tests.sh / tools/measure_coverage.py, and
# already out of date the moment the test suite changes.
.coverage
.coverage.*
coverage-unit.json
coverage-reports/
htmlcov/
*.gcov
*.gcda
*.gcno

# Test-mock debris: a test that leaks an unconfigured MagicMock into a real
# filesystem call (os.fspath() on the mock returns a fake-but-valid path)
# creates real files under a literal "MagicMock/" directory here. Fixed at
# the source (see tests/test_cli_unit.py), but this stays as a backstop.
/MagicMock/
